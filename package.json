{
  "name": "dairy-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix Client install && npm --prefix Client run build && npm --prefix Server install",
    "build:client": "npm --prefix Client run build",
    "start": "node --no-deprecation Server/index.js",
    "start:prod": "node --no-deprecation Server/index.js",
    "start:local": "npm --prefix Server run start:local",
    "dev:server": "npm --prefix Server run dev",
    "dev:client": "npm --prefix Client run dev",
    "tunnel": "node tunnel_manager.mjs"
  },
  "dependencies": {
    "node": "^26.7.0",
    "nodemailer": "^9.0.5"
  }
}
